MODE=api
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:54329/pixel_magic
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:54329/pixel_magic
DB_POOL_MAX=5
SUPABASE_URL=https://your-project.supabase.co
CORS_ORIGINS=http://localhost:3000
PADDLE_API_KEY=pdl_sdbx_dummy
PADDLE_WEBHOOK_SECRET=pdl_ntfset_dummy
PADDLE_ENV=sandbox
FREE_PLAN_NAME=free
CARRYOVER_VALIDITY_DAYS=30
PLAN_CHANGE_LOCK_MINUTES=60
CHECKOUT_REUSE_MINUTES=30
RENEWAL_GRACE_MINUTES=60
SUPABASE_SECRET_KEY=sb_secret_dummy
FAL_KEY=fal_dummy
API_PUBLIC_URL=http://localhost:8080
WORKER_URL=http://localhost:8081
STORAGE_BUCKET_INPUTS=inputs
STORAGE_BUCKET_OUTPUTS=outputs
FAL_JWKS_URL=https://rest.fal.ai/.well-known/jwks.json
# Set in production to our fal user id (rejects other accounts' webhooks)
# FAL_WEBHOOK_USER_ID=
TASKS_MODE=http
TASKS_QUEUE_GENERATION=generation
TASKS_QUEUE_FINALIZATION=finalization
# Required when TASKS_MODE=cloud:
# GCP_PROJECT_ID=
# GCP_REGION=
# TASKS_SERVICE_ACCOUNT=
MAX_ACTIVE_JOBS_PER_USER=4
UPLOAD_MAX_BYTES=20971520
UPLOAD_MIME_TYPES=image/png,image/jpeg,image/webp
