# Base URL of the Pixel Magic backend API (local default shown).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Supabase switch. On unless this is exactly "false". When false the app skips
# Supabase entirely (no sign-in, no session, no token on API calls) and the two
# Supabase values below are not needed. Restart or rebuild after changing it.
NEXT_PUBLIC_SUPABASE_ENABLED=true
# Supabase dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Publishable key (never the secret key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Paddle > Developer tools > Authentication > Client-side tokens. Starts with test_ in sandbox.
# Public by design; never the API key.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox or production.
NEXT_PUBLIC_PADDLE_ENV=sandbox
