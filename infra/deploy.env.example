# Settings for infra/setup.sh. Copy this file to infra/deploy.env (git-ignored)
# and fill it in. Use single quotes around values that contain special
# characters (&, ?, $, spaces, JSON). Run: bash infra/setup.sh
# Or keep it elsewhere: bash infra/setup.sh path/to/file.env

# ---- Project ---------------------------------------------------------------

# Your Google Cloud project id (not the project number).
GCP_PROJECT_ID=

# Region for Cloud Run, Cloud Tasks and Cloud Scheduler.
# Use your Supabase project's region (or the closest GCP one), e.g. us-central1.
GCP_REGION=

# ---- App config (not secret) -----------------------------------------------

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Comma-separated browser origins allowed to call the API. Start with localhost;
# once you have your Vercel URL, add it here and run setup.sh again, e.g.
# CORS_ORIGINS='http://localhost:3000,https://your-app.vercel.app'
CORS_ORIGINS='http://localhost:3000'

# sandbox or production.
PADDLE_ENV=sandbox

# Our fal account's user id. Rejects webhooks signed for other fal accounts.
# Optional on the first run; see "fal setup" in backend/README.md.
FAL_WEBHOOK_USER_ID=

# Supabase Storage bucket names (create both as private buckets).
STORAGE_BUCKET_INPUTS=inputs
STORAGE_BUCKET_OUTPUTS=outputs

# Name of the plan new users start on.
FREE_PLAN_NAME=free

# Optional JSON credit prices per model; replaces the built-in default.
# See "Credit pricing" in backend/README.md. Leave blank to use the default.
# TIERED_CREDIT_MAPPING='{"flux-schnell":{"tiers":[{"name":"Basic","isDefault":true,"meters":[{"metric":"images","unitSize":1,"rate":1}]}]}}'
TIERED_CREDIT_MAPPING=

# ---- Secrets (stored in Secret Manager; never printed) ---------------------

# Supabase transaction pooler, port 6543. Used by the API and worker.
# Supabase dashboard > Connect > Transaction pooler. URL-encode the password.
# DATABASE_URL='postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres'
DATABASE_URL=

# Supabase session pooler, port 5432, same pooler host (NOT db.<ref>.supabase.co,
# which is IPv6-only and unreachable from Cloud Run). Used by the migrate job.
# DATABASE_MIGRATION_URL='postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres'
DATABASE_MIGRATION_URL=

# Supabase secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=

# fal API key.
FAL_KEY=

# Paddle API key and the webhook destination's secret (pdl_ntfset_...).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
